{
  "name": "blockdia-motion",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "node scripts/serve.mjs",
    "test": "pnpm build:packages && node --test tests/*.test.mjs",
    "build": "pnpm runtime:build && node scripts/playground-examples.mjs",
    "build:playground": "pnpm build && node scripts/build-playground.mjs",
    "test:playground": "node --test tests/deployment/playground-pages.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "motion": "node packages/cli/dist/index.js",
    "test:integration": "pnpm runtime:build && node scripts/stage-fixture.mjs && node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "format:check": "prettier --check \"packages/**/*.{ts,js,json,html}\" \"apps/**/*.html\" \"examples/**/*.{ts,json}\" \"scripts/*.mjs\" \"tests/**/*.{mjs,json}\" \"docs/**/*.md\" \"README.md\" \"THIRD_PARTY_NOTICES.md\" \"package.json\"",
    "example:all-api": "pnpm build:packages && pnpm motion compile examples/all-api/tutorial.ts artifacts/all-api/tutorial.json",
    "runtime:build": "pnpm build:packages && node scripts/build-runtime.mjs",
    "shell:build": "pnpm build:packages && node scripts/build-shell.mjs",
    "bootstrap:blocks": "node scripts/bootstrap.mjs",
    "bootstrap:gui": "pnpm build:packages && node scripts/bootstrap-gui.mjs",
    "bootstrap:catalog": "node scripts/bootstrap-catalog.mjs",
    "example:basic": "pnpm build:packages && pnpm motion compile examples/basic-editing/tutorial.ts artifacts/basic-editing/tutorial.json",
    "example:structural": "pnpm build:packages && pnpm motion compile examples/structural-editing/tutorial.ts artifacts/structural-editing/tutorial.json",
    "example:targets": "pnpm runtime:build && node scripts/target-example.mjs",
    "test:catalog-reference": "pnpm runtime:build && node scripts/catalog-reference.mjs",
    "build:packages": "tsc -b",
    "benchmark:export": "pnpm runtime:build && node scripts/export-benchmark.mjs",
    "benchmark:compare": "pnpm runtime:build && node scripts/export-compare.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@blockdia-motion/authoring": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.13.4",
    "playwright-core": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
