{
  "schemaVersion": 1,
  "adapter": "turbowarp",
  "project": {
    "targets": [
      {
        "id": "stage",
        "name": "舞台",
        "isStage": true,
        "x": 0,
        "y": 0,
        "size": 100,
        "direction": 90,
        "visible": true,
        "costumes": ["背景1"],
        "sounds": [],
        "variables": [],
        "procedures": []
      },
      {
        "id": "sprite",
        "name": "角色1",
        "isStage": false,
        "x": 0,
        "y": 0,
        "size": 100,
        "direction": 90,
        "visible": true,
        "costumes": ["造型1"],
        "sounds": [],
        "variables": [],
        "procedures": []
      }
    ]
  },
  "initialTarget": "sprite",
  "viewport": {
    "width": 1280,
    "height": 720
  },
  "defaults": {
    "theme": "light",
    "locale": "zh-CN"
  },
  "steps": [
    {
      "op": "sequence",
      "steps": [
        {
          "op": "create",
          "blocks": [
            {
              "id": "repeat",
              "opcode": "control_repeat",
              "inputs": {
                "TIMES": {
                  "shadow": {
                    "id": "times",
                    "opcode": "math_whole_number",
                    "fields": {
                      "NUM": "10"
                    }
                  }
                }
              }
            }
          ],
          "to": {
            "kind": "workspaceSlot",
            "name": "main"
          },
          "duration": 0.2
        },
        {
          "op": "create",
          "blocks": [
            {
              "id": "say",
              "opcode": "looks_say",
              "inputs": {
                "MESSAGE": {
                  "shadow": {
                    "id": "message",
                    "opcode": "text",
                    "fields": {
                      "TEXT": "你好"
                    }
                  }
                }
              }
            }
          ],
          "to": {
            "kind": "workspaceSlot",
            "name": "secondary"
          },
          "duration": 0.2
        },
        {
          "op": "connect",
          "id": "say",
          "to": {
            "kind": "connection",
            "id": "repeat",
            "name": "SUBSTACK"
          },
          "duration": 0.5
        },
        {
          "op": "type",
          "target": {
            "kind": "field",
            "id": "message",
            "name": "TEXT"
          },
          "value": "你好，欢迎学习积木编程"
        },
        {
          "op": "highlight",
          "id": "say",
          "duration": 0.3
        },
        {
          "op": "wait",
          "duration": 0.4
        },
        {
          "op": "split",
          "id": "say",
          "to": {
            "kind": "workspaceSlot",
            "name": "secondary"
          },
          "duration": 0.5
        },
        {
          "op": "type",
          "target": {
            "kind": "field",
            "id": "message",
            "name": "TEXT"
          },
          "value": "你好"
        },
        {
          "op": "annotate",
          "id": "say",
          "text": "从容器中拆出后仍保留文本",
          "duration": 0.4
        },
        {
          "op": "delete",
          "id": "say",
          "duration": 0.4
        },
        {
          "op": "create",
          "blocks": [
            {
              "id": "reporter",
              "opcode": "operator_add",
              "inputs": {
                "NUM1": {
                  "shadow": {
                    "id": "n1",
                    "opcode": "math_number",
                    "fields": {
                      "NUM": "1"
                    }
                  }
                },
                "NUM2": {
                  "shadow": {
                    "id": "n2",
                    "opcode": "math_number",
                    "fields": {
                      "NUM": "2"
                    }
                  }
                }
              }
            }
          ],
          "to": {
            "kind": "workspaceSlot",
            "name": "secondary"
          },
          "duration": 0.2
        },
        {
          "op": "connect",
          "id": "reporter",
          "to": {
            "kind": "connection",
            "id": "repeat",
            "name": "TIMES"
          },
          "duration": 0.5
        },
        {
          "op": "wait",
          "duration": 0.6
        },
        {
          "op": "split",
          "id": "reporter",
          "to": {
            "kind": "workspaceSlot",
            "name": "secondary"
          },
          "duration": 0.5
        },
        {
          "op": "delete",
          "id": "reporter",
          "duration": 0.3
        },
        {
          "op": "create",
          "blocks": [
            {
              "id": "rotation",
              "opcode": "motion_setrotationstyle",
              "fields": {
                "STYLE": "all around"
              }
            }
          ],
          "to": {
            "kind": "workspaceSlot",
            "name": "secondary"
          },
          "duration": 0.2
        },
        {
          "op": "choose",
          "target": {
            "kind": "field",
            "id": "rotation",
            "name": "STYLE"
          },
          "value": "left-right",
          "duration": 0.5
        },
        {
          "op": "setField",
          "target": {
            "kind": "field",
            "id": "times",
            "name": "NUM"
          },
          "value": "20",
          "duration": 0.2
        },
        {
          "op": "wait",
          "duration": 0.3
        }
      ]
    }
  ]
}
